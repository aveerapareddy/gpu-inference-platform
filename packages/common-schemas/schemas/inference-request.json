{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-inference-platform/schemas/inference-request.json",
  "title": "InferenceRequest",
  "description": "Internal request after gateway validation. Owner: API gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "model", "messages", "stream", "max_tokens"],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {
            "$ref": "enums.json#/$defs/MessageRole"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "stream": {
      "type": "boolean"
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "priority_class": {
      "$ref": "enums.json#/$defs/PriorityClass"
    },
    "api_key_id": {
      "type": "string"
    },
    "client_request_id": {
      "type": "string"
    }
  }
}
