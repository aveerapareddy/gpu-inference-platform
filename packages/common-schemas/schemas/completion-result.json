{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-inference-platform/schemas/completion-result.json",
  "title": "CompletionResult",
  "description": "Terminal success payload. Owner: inference adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "status",
    "finish_reason",
    "completed_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "finish_reason": {
      "$ref": "enums.json#/$defs/FinishReason"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "TokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "total_tokens"
      ],
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
