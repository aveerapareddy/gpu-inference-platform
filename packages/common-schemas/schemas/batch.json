{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-inference-platform/schemas/batch.json",
  "title": "Batch",
  "description": "Dispatch unit to inference adapter. Owner: scheduler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "model",
    "worker_id",
    "assignments",
    "created_at",
    "state"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "model": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "batch-assignment.json"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_batch_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "$ref": "enums.json#/$defs/BatchState"
    }
  }
}
