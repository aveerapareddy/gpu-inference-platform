{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-inference-platform/schemas/model-record.json",
  "title": "ModelRecord",
  "description": "Control plane model registry entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "backend",
    "pool_id",
    "max_output_tokens",
    "max_prompt_tokens"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "pool_id": {
      "type": "string"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "max_prompt_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "default_temperature": {
      "type": "number"
    }
  }
}
